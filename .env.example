# ── Aithrex resume/jobs backend — local environment ──────────────────
# Copy to `.env` and fill in. Never commit the real .env.

# Runtime
ENVIRONMENT=development          # development | prod
USE_SSM_SECRETS=false           # true only in AWS Lambda (reads SSM Parameter Store)
FLASK_DEBUG=true
LOG_LEVEL=INFO

# Opt-in tailoring policy. Enable on both API and worker after live quality review.
# Existing versioned refinements keep their policy when this is turned off.
EVIDENCE_TAILORING_ENABLED=false
PORT=5000

# CORS — the Aithrex resume frontend origin(s)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Auth. JobPilot now MINTS and validates its own JWTs (in-house /api/auth).
# IMPORTANT (retrofit): set this to the SAME byte-for-byte value the old
# portfolio auth service used, so existing user sessions stay valid and no one
# is forced to re-login after the migration. In dev, leave blank to auto-generate
# a per-process secret (tokens reset on restart).
JWT_SECRET_KEY=

# Public URLs (auth reset links + social sign-in redirect landing).
# FRONTEND_URL defaults to the first ALLOWED_ORIGINS entry if unset.
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:5000

# Database (currently the same MongoDB as portfolio)
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=aspirely_db

# Resume file storage
RESUME_S3_BUCKET=
AWS_REGION=us-east-1

# Job-search providers
JSEARCH_API_KEY=

# USAJOBS — the federal government's official Search API
# (https://developer.usajobs.gov/apirequest/). BOTH are required: the API sends
# 401/403 without them. The user agent must be the email address the key was
# issued to. Leave blank and the `usajobs` ATS provider parks itself — it
# reports BLOCKED ("credentials not configured") per endpoint and makes no
# request, rather than retiring federal employers as dead boards.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# ══ AI: LLM provider selection ═══════════════════════════════════════════
# Which LLM serves ALL AI features (tailoring, parsing, JD analysis, ATS
# scoring, copilot). Exactly ONE provider is active at a time — when set to
# `gemini`, AWS Bedrock is never called, and vice versa.
#
# This is a developer/ops cost lever, NOT a user-facing setting.
#   claude  → Anthropic Claude on AWS Bedrock  (default)
#   gemini  → Google Gemini via google-genai
#
# Locally: set it here and restart `python local.py`.
# In prod: it comes from SSM, so no redeploy is needed —
#   aws ssm put-parameter --name /jobpilot/prod/llm-provider \
#     --value gemini --type String --overwrite
# An unrecognized value fails fast at startup rather than silently
# defaulting, so a typo can't route traffic (and cost) to the wrong provider.
LLM_PROVIDER=claude

# ── AI provider 1: Claude on AWS Bedrock ──
# Required when LLM_PROVIDER=claude.
# 1) Create an IAM user/role with `bedrock:InvokeModel` and put its keys here.
# 2) In the AWS console → Bedrock → Model access, enable Anthropic
#    Claude Haiku 4.5 and Sonnet 4.6 IN THIS REGION.
# 3) Validate with:  python scripts/check_bedrock.py
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=     # only if using temporary STS credentials
BEDROCK_REGION=us-east-1   # a region where you enabled Claude access (us-east-1 / us-west-2)
# Optional model overrides (defaults: Haiku 4.5 FLASH/PREVIEW, Sonnet 4.6 PRO):
# BEDROCK_FLASH_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_PRO_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ── AI provider 2: Google Gemini (google-genai / AI Studio) ──
# Required when LLM_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
# Validate with:  python scripts/check_gemini.py
GEMINI_API_KEY=
# Optional model overrides (defaults: 2.5 Flash FLASH/PREVIEW, 2.5 Pro PRO):
# GEMINI_FLASH_MODEL_ID=gemini-2.5-flash
# GEMINI_PRO_MODEL_ID=gemini-2.5-pro
# GEMINI_PREVIEW_MODEL_ID=gemini-2.5-flash

# Optional features
IPINFO_TOKEN=
JOB_SEARCH_PASSWORD_HASH=
GITHUB_PAT=

# Gmail OAuth (Applications-tab auto-status feature) — optional.
# This is the Gmail-SYNC integration (reads inbox). It is SEPARATE from the
# Google SIGN-IN credentials below — do not reuse the same client/redirect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEY=

# ── Social sign-in ("Continue with …") — optional, each provider independent ──
# Redirect URIs are SERVER routes on this backend:
#   ${BACKEND_PUBLIC_URL}/api/auth/oauth/<provider>/callback
# Register that exact URL in each provider's console. Any provider left blank
# is simply hidden from the login screen (the /authorize endpoint returns 503).

# Google sign-in (DISTINCT from the Gmail-sync client above)
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn (OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Microsoft (Azure AD / Entra, OpenID Connect). TENANT defaults to "common".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Apple Sign In (OIDC, form_post). Client secret is an ES256 JWT minted from
# the .p8 private key — see services/oauth_service.py.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Connect & act data-integrations (act on the user's behalf) — optional ──
# DISTINCT from the social SIGN-IN above. These let a logged-in user connect
# GitHub / LinkedIn so JobPilot can create repos / publish posts FOR them — not
# scraping. Tokens are Fernet-encrypted at rest with the key below (falls back to
# GMAIL_TOKEN_ENCRYPTION_KEY if unset). Each provider's redirect URI is a SERVER
# route under the already-edge-routed /api/resume prefix:
#   ${BACKEND_PUBLIC_URL}/api/resume/connect/<provider>/callback
# Register that EXACT URL in each provider's app console. Blank creds → 503.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# GitHub Connect OAuth app. Requires the "public_repo" scope (granted to the app
# at consent) so JobPilot can create repos / push files. Falls back to the
# GITHUB_CLIENT_ID/SECRET sign-in app if these are unset.
GITHUB_CONNECT_CLIENT_ID=
GITHUB_CONNECT_CLIENT_SECRET=

# LinkedIn Connect OAuth app. Requires the "Share on LinkedIn" product to be
# APPROVED on the app (grants the w_member_social scope) before posting works.
# Falls back to the LINKEDIN_CLIENT_ID/SECRET sign-in app if these are unset.
LINKEDIN_CONNECT_CLIENT_ID=
LINKEDIN_CONNECT_CLIENT_SECRET=

# ── Transactional email (password reset, notifications) — optional ──
# EMAIL_PROVIDER selects the transport: `zeptomail` (Zoho transactional API) or
# `ses` (AWS SES). Default is `ses`. If the selected provider isn't configured
# in dev, emails are logged to the console instead.
EMAIL_PROVIDER=zeptomail
# EMAIL_FALLBACK_PROVIDER is retried when the primary transport errors. Sends
# are best-effort (a dead mailer must never break signup or password reset), so
# without a fallback a bad credential silently drops every email — exactly what
# an invalid ZeptoMail token did to password resets. Defaults to "the transport
# you aren't using"; set to `none` to disable.
EMAIL_FALLBACK_PROVIDER=ses
# Shared across providers (From header + optional Reply-To). email_service reads
# EMAIL_FROM_ADDRESS/EMAIL_REPLY_TO first, then falls back to the SES_* names.
EMAIL_FROM_ADDRESS=Aspirely <no-reply@aspirely.me>
EMAIL_REPLY_TO=support@aithrex.tech
# ZeptoMail: the Mail Agent's "Send Mail" token (bare token or the full
# `Zoho-enczapikey ...` value — both accepted). Prod: SSM secret
# SSM_ZEPTOMAIL_TOKEN → <prefix>/zeptomail-token. ZEPTOMAIL_API_URL only needed
# for non-US data centres (default is the .com host).
ZEPTOMAIL_TOKEN=
# ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# AWS SES (legacy fallback provider):
SES_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@jobpilot.app

# ── Managed Application Mailbox (managed-mailbox-v1) — optional, OFF by default ──
# The "apply from a managed address" relay: users get a stable
# firstname.lastname@<APPLY_MAIL_DOMAIN> address to hand to employers/ATS.
# The whole feature is INERT until a neutral domain + Cloudflare Email Routing
# Worker + an SSE-KMS S3 bucket + the /api/mail-inbound edge route exist AND the
# master flag is flipped on (see docs/specs/managed-mailbox-v1.md §11/§12).
# Provisioning the address model works locally with just APPLY_MAIL_DOMAIN set.
APPLY_MAIL_DOMAIN=                 # neutral domain, e.g. pilotmail.co. Empty => inert (D3).
APPLY_MAILBOX_ENABLED=false        # master flag; OFF everywhere until infra is live.
APPLY_MAIL_BUCKET=                 # SSE-KMS bucket for raw MIME + attachment quarantine.
# HMAC secret shared with the Cloudflare Email Worker's secret binding (verifies
# the inbound webhook). Prod: SSM via SSM_MAIL_INBOUND_HMAC_SECRET. NEVER the JWT secret.
MAIL_INBOUND_HMAC_SECRET=
APPLY_MAIL_KMS_KEY_ID=             # CMK id for APPLY_MAIL_BUCKET. Prod: SSM via SSM_APPLY_MAIL_KMS_KEY_ID.
MAIL_FORWARD_FROM=                 # JobPilot-owned verified relay sender (never the recruiter), e.g. notifications@aspirely.me.
# Reply-relay sending mode. When a user replies to a forwarded recruiter email
# from their own inbox, the reply routes through a per-thread reply-bound alias
# (reply.<hex>@APPLY_MAIL_DOMAIN) and is relayed BACK to the recruiter — never
# exposing the user's real address. OFF (default): the relay goes out From the
# fallback MAIL_FORWARD_FROM with a "<first name> (via My Private Mail)" display.
# ON: it goes out From the user's PRIMARY managed alias — flip to true ONLY after
# APPLY_MAIL_DOMAIN is verified as a ZeptoMail sending domain (SPF/DKIM) and you
# assert that via APPLY_MAIL_SENDING_VERIFIED. Either way, NEVER the real email.
APPLY_MAIL_SEND_AS_ALIAS=false     # relay reply From = primary alias (needs verified sending domain).
APPLY_MAIL_SENDING_VERIFIED=       # operator assertion that APPLY_MAIL_DOMAIN is DNS-verified for sending. Empty => mirrors SEND_AS_ALIAS.

# ── Employer (ATS) account creation + credential vault ──
# When an employer requires a candidate account, JobPilot registers one FOR the
# user with their managed private alias and a 24-char server-generated password
# kept under KMS envelope encryption (services/ats_credential_service.py).
# Implemented for WORKDAY ONLY today; every other vendor still hands the wall
# back to the user with an honest message.
# ONE Workday password per user, shared across ALL Workday tenants (the
# canonical vault row is tenant=""); a tenant that already owned its own
# password from before that rule KEEPS it, because the employer's side has that
# exact password. The sharing boundary is ats_credential_service
# .SHARED_PASSWORD_FAMILIES — Greenhouse/Lever/Ashby never inherit it.
ATS_AUTO_ACCOUNT=true              # false => park the row on the account wall instead of self-registering.
CREDENTIALS_KMS_KEY_ID=            # CMK for the credential vault. Empty => the vault refuses to store/reveal.

# ── Guest Onboarding ──
# Server-side salt for guest_sessions.ip_hash (sha256(ip + salt), abuse
# correlation only — never the raw IP). UNSET → fail closed: ip_hash is
# stored as null (feature still works; no IP correlation). Prod: SSM secret
# via SSM_GUEST_IP_HASH_SALT (see MANUAL_STEPS.md).
GUEST_IP_HASH_SALT=

# Trusted forwarders in FRONT of API Gateway that append the true peer IP to
# X-Forwarded-For (CloudFront = 1, the default). Set 0 if API Gateway is ever
# exposed directly so only the connection source IP is trusted.
TRUSTED_PROXY_HOPS=1
