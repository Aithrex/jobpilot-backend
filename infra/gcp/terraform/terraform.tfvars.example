# Copy to terraform.tfvars and fill in. NEVER commit real values / secrets.
gcp_project_id      = "jobpilot-exec-prod"
gcp_region          = "us-east1"
gcp_billing_account = "XXXXXX-XXXXXX-XXXXXX"

# The AWS side that is allowed to enqueue tasks (WIF).
aws_account_id      = "123456789012"
aws_lambda_role_arn = "arn:aws:iam::123456789012:role/jobpilot-lambda-exec-prod"

# Set after the first image is pushed (or let CI update the Cloud Run revision).
# worker_image = "us-east1-docker.pkg.dev/jobpilot-exec-prod/jobpilot-apply-executor/worker:prod"

gcp_monthly_budget = 100
# budget_notification_channels = ["projects/jobpilot-exec-prod/notificationChannels/123"]
