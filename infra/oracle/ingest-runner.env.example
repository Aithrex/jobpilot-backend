# /etc/jobpilot/ingest-runner.env  (root:jobpilot 0640) - NEVER commit the real one.
#
# Off AWS there is no instance profile, so the two things the crawl needs
# from outside the box are here and nowhere else. CloudTrail on the EC2 box
# (2026-09-30 -> 10-01) showed it calls exactly: SSM GetParameters (the Mongo
# URI) and S3 (the JD store). No Bedrock, no Lambda.

USE_SSM_SECRETS=false
MONGODB_URI=

# IAM user `jobpilot-ingest-oracle` (see README.md): s3:GetObject on the
# bucket, s3:PutObject on job-jd/* and job-archive/* only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
