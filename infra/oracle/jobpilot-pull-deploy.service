[Unit]
Description=JobPilot ingest runner - pull deploy from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jobpilot-pull-deploy
# QUOTED: unquoted, systemd splits on spaces and git runs bare `ssh` without
# the deploy key (Permission denied (publickey) on the first deploy).
Environment="GIT_SSH_COMMAND=ssh -i /root/.ssh/jobpilot_deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
# pip + the runner's 150s drain on restart.
TimeoutStartSec=900
