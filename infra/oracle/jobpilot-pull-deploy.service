[Unit]
Description=JobPilot ingest runner - pull deploy from git
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/jobpilot-pull-deploy
# GIT_SSH_COMMAND is set inside pull-deploy.sh, not here: this unit is
# reinstalled from the checkout on every deploy, so it must not be the thing
# that decides whether the next fetch can authenticate.
# pip + the runner's 150s drain on restart.
TimeoutStartSec=900
